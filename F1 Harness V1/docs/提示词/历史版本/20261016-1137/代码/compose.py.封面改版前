VOICE_EQ = "equalizer=f=1581:t=q:w=0.5:g=-2.5"
BGM_GAIN_DB = -20.5
LOOP_XFADE = 0.1
DUCK_MAX_DB = 3.5
DUCK_THRESHOLD_DB = -26.0
DUCK_KNEE_DB = 6.0
DUCK_ATTACK_MS, DUCK_RELEASE_MS = 20, 400
DUCK_RMS_MS, DUCK_LOOKAHEAD_MS, DUCK_HOLD_MS = 40, 30, 80   # 沿用雪邦混音参数.json
TARGET_LUFS, TARGET_TP = -16.0, -1.5
LIMIT_DB = -1.7                                            # 限幅留 0.2 dB 余量

WM_WIDTH, WM_MARGIN = 160, 28
PREVIEW_SIZE = (960, 540)
# 雪邦成片：H.264 High 约 5.7 Mbps、AAC 约 200 kbps
