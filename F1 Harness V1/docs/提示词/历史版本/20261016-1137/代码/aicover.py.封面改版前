class CoverError(RuntimeError):
    pass


# ---------- 文字 ----------

def cover_texts(branch: str | None, publish_title: str) -> dict:
    """小标签用分支前缀；发布标题按第一个空格分成主标题、副标题。"""
    head, _, tail = publish_title.strip().partition(" ")
    out = {"label": episodes.TITLE_PREFIX.get(branch or "", branch or ""), "main": head.strip()}
    if tail.strip():
        out["sub"] = tail.strip()
    return {k: v for k, v in out.items() if v}


def _texts_block(t: dict) -> str:
    names = {"label": "小标签", "main": "主标题", "sub": "副标题"}
    return "\n".join(f"- {names[k]}：{t[k]}" for k in ("label", "main", "sub") if k in t)


def text_score(want: str, lines: list[str]) -> float:
    """want 里有多少比例的字按顺序出现在识别结果里（标题常被拆成几行）。"""
    got = "".join(lines).replace(" ", "")
    want = want.replace(" ", "")
    if not want:
        return 1.0
    blocks = difflib.SequenceMatcher(None, want, got, autojunk=False).get_matching_blocks()
    return sum(b.size for b in blocks) / len(want)


def check_text(path: Path, texts: dict, *, ocr=None) -> dict:
    if ocr is None:
        from .local_tags import ocr
    lines = [x["t"] for x in ocr([path]).get(str(path), [])]
    scores = {k: round(text_score(v, lines), 2) for k, v in texts.items()}
    return {"ok": all(s >= TEXT_MIN for s in scores.values()), "scores": scores, "lines": lines}


# ---------- 候选画面 ----------

def _source(asset_id: int) -> Path:
    return config.LIBRARY_DIR / str(asset_id) / "source.mp4"


def candidates(conn, ep_dir: Path, subjects: list[dict], *, search=None) -> list[dict]:
    """本期成片用到的镜头（取实际用到那段的中点）在前，再按每个主体从整个素材库搜；只收本地有原片的。"""
    out, seen = [], set()
    tl_path = ep_dir / "06_合成" / "时间线.json"
    tl = json.loads(tl_path.read_text(encoding="utf-8")) if tl_path.exists() else {}
    for c in tl.get("video", []):
        key = (c["asset_id"], c.get("shot_idx"))
        if key in seen or not _source(c["asset_id"]).exists():
            continue
        seen.add(key)
        out.append({"asset_id": c["asset_id"], "shot_idx": c.get("shot_idx"),
                    "t": (c["src_in"] + c["src_out"]) / 2, "from": "本期"})
        if len(out) >= TIMELINE_MAX:
            break
    if search is None:
        from .visual_search import search
    for s in subjects:
        for r in search(conn, s["query"], limit=SEARCH_PER_SUBJECT * 2):
            key = (r["asset_id"], r["shot_idx"])
            if key in seen or not _source(r["asset_id"]).exists():
                continue
            seen.add(key)
            out.append({"asset_id": r["asset_id"], "shot_idx": r["shot_idx"],
                        "t": (r["start_s"] + r["end_s"]) / 2, "from": f"素材库·{s['name']}"})
            if sum(1 for o in out if o["from"].endswith(s["name"])) >= SEARCH_PER_SUBJECT:
                break
    for i, o in enumerate(out, 1):
        o["n"] = i
    return out


def grab(item: dict, out: Path, width: int | None = None) -> Path:
    vf = ["-vf", f"scale={width}:-2"] if width else []
    subprocess.run([FFMPEG, "-loglevel", "error", "-y", "-ss", f"{item['t']:.2f}", "-i", str(_source(item["asset_id"])),
                    "-frames:v", "1", *vf, str(out)], check=True, timeout=120)
    return out


def contact_sheet(items: list[dict], work: Path, cols: int = 5) -> Path:
    W, H = TILE
    rows = (len(items) + cols - 1) // cols
    sheet = Image.new("RGB", (W * cols, H * rows))
    font = ImageFont.truetype("/System/Library/Fonts/Helvetica.ttc", 36)
    d = ImageDraw.Draw(sheet)
    tmp = work / "_tile.jpg"
    for i, it in enumerate(items):
        try:
            grab(it, tmp, width=W)
            im = Image.open(tmp).convert("RGB")
        except (subprocess.SubprocessError, OSError) as e:
            log.warning("候选帧取不出来 %s：%s", it, e)
            continue
        im.thumbnail((W, H))
        x, y = (i % cols) * W, (i // cols) * H
        sheet.paste(im, (x, y))
        d.rectangle([x, y, x + 64, y + 44], fill="black")
        d.text((x + 5, y + 2), str(it["n"]), fill="yellow", font=font)
    tmp.unlink(missing_ok=True)
    out = work / "候选拼图.jpg"
    sheet.save(out, quality=85)
    return out


# ---------- 成品 ----------

def finish(src: Path, orientation: str, out: Path) -> Path:
    """居中裁成成品尺寸，左上角加水印（位置大小同模板封面）。"""
    W, H = cover.SIZES[orientation]
    im = Image.open(src).convert("RGB")
    s = max(W / im.width, H / im.height)
    im = im.resize((round(im.width * s), round(im.height * s)), Image.LANCZOS)
    x, y = (im.width - W) // 2, (im.height - H) // 2
    im = im.crop((x, y, x + W, y + H))
    wm = cover._watermark(str(config.BRAND_DIR / "watermark.png"))
    im.paste(wm, (cover.WM_MARGIN, cover.WM_MARGIN), wm)
    out.parent.mkdir(parents=True, exist_ok=True)
    im.save(out)
    return out


def _json(text: str) -> dict:
    try:
        return json.loads(text[text.index("{"):text.rindex("}") + 1])
    except ValueError as e:
        raise CoverError(f"模型没按格式回复：{text[:200]}") from e


def _generated(work: Path, name: str, thread_id: str | None) -> Path | None:
    p = work / f"{name}.png"
    if p.exists():
        return p
    if thread_id:   # 模型没复制过来时去 Codex 的生成目录找
        hits = sorted((Path.home() / ".codex" / "generated_images" / thread_id).glob("*.png"),
                      key=lambda x: x.stat().st_mtime)
        if hits:
            return Path(shutil.copyfile(hits[-1], p))
    return None


# ---------- 主流程 ----------

async def generate(conn, ep, publish_title: str, desc: str, *, note: str | None = None,
                   runner=None, search=None, ocr=None) -> dict:
    """出横竖两张 AI 封面写到 06_合成/封面_横版.png、封面_竖版.png（旧的先存到 封面版本/<时间>/）。
    返回说明（主体、底图、每个方向几次通过、哪个方向退回模板），同时写 06_合成/封面说明.json。"""
    run = runner or codex_runner.run
    model, effort = config.ROLE_MODELS["图形"]
    ep_dir = Path(ep["folder"])
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    work = ep_dir / "06_合成" / "AI封面" / stamp
    work.mkdir(parents=True, exist_ok=True)
    note_line = f"用户对封面的意见（优先照办）：{note}\n" if note else ""

    async def ask(prompt: str, images: list[Path] | None = None, **kw):
        r = await run(prompt, model, effort, work, images=images, timeout=CODEX_TIMEOUT, **kw)
        codex_runner.record_usage(conn, r, model=model, effort=effort, episode_id=ep["id"])
        return r

    r = await ask(SUBJECT_INSTRUCTION.format(title=publish_title, desc=desc or "无", note=note_line), ephemeral=True)
    subjects = [s for s in _json(r.message).get("subjects", []) if s.get("query")][:2]
    if not subjects:
        raise CoverError("模型没给出封面主体")
    items = await asyncio.to_thread(candidates, conn, ep_dir, subjects, search=search)
    if not items:
        raise CoverError("找不到候选画面（本期镜头和素材库都没有本地原片）")
    sheet = await asyncio.to_thread(contact_sheet, items, work)
    r = await ask(PICK_INSTRUCTION.format(title=publish_title, desc=desc or "无", note=note_line,
                                          subjects="、".join(s["name"] for s in subjects)),
                  images=[sheet], ephemeral=True)
    picked = _json(r.message)
    by_n = {it["n"]: it for it in items}
    chosen = [by_n[n] for n in picked.get("pick", []) if n in by_n][:2]
    if not chosen:
        raise CoverError(f"模型挑的编号不在候选里：{picked.get('pick')}")
    frames = [await asyncio.to_thread(grab, it, work / f"底图_{it['asset_id']}_{it['shot_idx']}.jpg")
              for it in chosen]

    refs = sorted(p for p in REF_DIR.glob("*.png") if not p.name.startswith("._"))
    texts = cover_texts(ep["branch"], publish_title)

    async def one(orient: str) -> dict:
        shape, final, cut, (wm_w, wm_h), layout = GEN_SHAPE[orient]
        tries = []
        for attempt in range(1 + RETRIES):
            name = f"{orient}_{attempt + 1}"
            prompt = GEN_INSTRUCTION.format(
                shape=shape, nref=len(refs), logo_no=len(refs) + 1, first_frame=len(refs) + 2, nframes=len(frames),
                texts=_texts_block(texts), layout=layout, wm_w=wm_w, wm_h=wm_h, final=final, cut=cut,
                note=note_line, name=name)
            try:
                r = await ask(prompt, images=[*refs, config.BRAND_DIR / "watermark.png", *frames])
            except codex_runner.QuotaExhausted:
                raise
            except codex_runner.CodexError as e:
                tries.append({"attempt": attempt + 1, "error": str(e)[:300]})
                continue
            raw = _generated(work, name, r.thread_id)
            if raw is None:
                tries.append({"attempt": attempt + 1, "error": "没找到生成的图片"})
                continue
            done = await asyncio.to_thread(finish, raw, orient, work / f"{name}_成品.png")
            chk = await asyncio.to_thread(check_text, done, texts, ocr=ocr)
            tries.append({"attempt": attempt + 1, "file": str(done), **chk})
            if chk["ok"]:
                return {"ok": True, "file": done, "tries": tries}
        return {"ok": False, "tries": tries}

    res = dict(zip(("landscape", "portrait"), await asyncio.gather(one("landscape"), one("portrait"))))
    out_dir = ep_dir / "06_合成"
    names = {"landscape": "封面_横版.png", "portrait": "封面_竖版.png"}
    backup = out_dir / "封面版本" / stamp
    for orient, r in res.items():
        if not r["ok"]:
            continue
        cur = out_dir / names[orient]
        if cur.exists():
            backup.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(cur, backup / cur.name)
        shutil.copyfile(r["file"], cur)
    info = {
        "time": stamp, "note": note, "texts": texts, "subjects": subjects,
        "picked": [{k: it[k] for k in ("n", "asset_id", "shot_idx", "t", "from")} for it in chosen],
        "reason": picked.get("reason", ""), "candidates": len(items), "work": str(work),
        "result": {o: {"ok": r["ok"], "attempts": len(r["tries"]), "tries": [
            {k: v for k, v in t.items() if k != "lines"} for t in r["tries"]]} for o, r in res.items()},
    }
    (out_dir / "封面说明.json").write_text(json.dumps(info, ensure_ascii=False, indent=1, default=str),
                                         encoding="utf-8")
    return info


def summary(info: dict) -> str:
    """给会话看的一段话。"""
    names = {"landscape": "横版", "portrait": "竖版"}
    parts = []
    for o, r in info["result"].items():
        parts.append(f"{names[o]}第 {r['attempts']} 次通过文字核对" if r["ok"]
                     else f"{names[o]}出了 {r['attempts']} 次文字都没核对上，保留原来的封面")
    pics = "、".join(f"素材 {p['asset_id']}" + (f" 镜头 {p['shot_idx']}" if p.get("shot_idx") is not None else "")
                    + f"（{p['from']}）" for p in info["picked"])
    return (f"AI 封面：主体 {'、'.join(s['name'] for s in info['subjects'])}；底图 {pics}。"
            f"{info.get('reason') or ''} {'；'.join(parts)}。")
