def test_usable_end_clamps_shots(conn, monkeypatch):
    monkeypatch.setattr(edit.visual_search, "search", lambda *a, **k: [])
    y = _asset(conn, [(0.0, 50.0, _tags()), (50.0, 95.0, _tags()), (95.0, 100.0, _tags())],
